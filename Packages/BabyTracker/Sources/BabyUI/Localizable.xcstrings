    "Your entries are still on this device. Trying again usually helps.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Einträge sind weiterhin auf diesem Gerät. Ein erneuter Versuch hilft meist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos entrées sont toujours sur cet appareil. Réessayer résout généralement le problème."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus registros siguen en este dispositivo. Volver a intentarlo suele ayudar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue voci sono ancora su questo dispositivo. Di solito basta riprovare."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші записи залишилися на цьому пристрої. Спробуйте ще раз."
          }
        }
      }
    },
