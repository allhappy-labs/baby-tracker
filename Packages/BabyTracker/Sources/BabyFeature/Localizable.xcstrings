    "Choose the reference used for growth comparisons. The expected due date is optional.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle die Referenz für Wachstumsvergleiche. Der errechnete Geburtstermin ist optional."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige la referencia para comparar el crecimiento. La fecha prevista de parto es opcional."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez la référence pour les comparaisons de croissance. La date prévue d’accouchement est facultative."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli il riferimento per i confronti della crescita. La data prevista del parto è facoltativa."
