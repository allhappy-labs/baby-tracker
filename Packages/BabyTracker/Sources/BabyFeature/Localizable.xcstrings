    "Already tracking with another caregiver? Join their family to see the same babies and records.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasst eine andere Betreuungsperson bereits Daten? Tritt ihrer Familie bei, um dieselben Babys und Einträge zu sehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre proche suit déjà votre bébé ? Rejoignez sa famille pour voir les mêmes bébés et enregistrements."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Otra persona cuidadora ya registra datos? Únete a su familia para ver los mismos bebés y registros."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un altro caregiver registra già i dati? Unisciti alla sua famiglia per vedere gli stessi bambini e registri."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже ведете записи разом з іншою людиною? Приєднайтеся до її сім’ї, щоб бачити тих самих дітей і записи."
          }
        }
      }
    },
