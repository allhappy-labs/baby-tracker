    "Choose a reference to enable growth comparisons. Existing measurements remain available without one.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine Referenz für Wachstumsvergleiche. Vorhandene Messungen bleiben auch ohne Referenz verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una referencia para comparar el crecimiento. Las mediciones existentes siguen disponibles sin ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une référence pour comparer la croissance. Les mesures existantes restent disponibles sans référence."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un riferimento per confrontare la crescita. Le misurazioni esistenti restano disponibili anche senza."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть референс для порівняння росту. Наявні вимірювання доступні й без нього."
          }
        }
      }
    },
    "Growth settings could not be loaded. Saving will only update name and birth date.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wachstumseinstellungen konnten nicht geladen werden. Beim Speichern werden nur Name und Geburtsdatum aktualisiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron cargar los ajustes de crecimiento. Al guardar solo se actualizarán el nombre y la fecha de nacimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger les réglages de croissance. L’enregistrement modifiera uniquement le nom et la date de naissance."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile caricare le impostazioni di crescita. Il salvataggio aggiornerà solo il nome e la data di nascita."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завантажити налаштування росту. Збереження оновить лише ім’я та дату народження."
          }
        }
      }
    },
