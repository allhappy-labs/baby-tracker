    "%@ becomes the owner and can manage caregivers and invitations. You become a caregiver.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird Inhaber und kann Betreuungspersonen und Einladungen verwalten. Du wirst Betreuungsperson."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ devient propriétaire et peut gérer les personnes aidantes et les invitations. Vous devenez une personne aidante."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se convierte en propietario y puede gestionar cuidadores e invitaciones. Tú pasas a ser cuidador."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ diventa proprietario e può gestire caregiver e inviti. Tu diventi un caregiver."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
