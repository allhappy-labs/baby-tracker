    "Tap a baby to correct their name or birth date.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf ein Baby, um seinen Namen oder sein Geburtsdatum zu korrigieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez un bébé pour corriger son nom ou sa date de naissance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un bebé para corregir su nombre o fecha de nacimiento."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un bebè per correggere il nome o la data di nascita."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a baby to correct their name or birth date."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться дитини, щоб змінити її ім’я або дату народження."
          }
        }
      }
    },
