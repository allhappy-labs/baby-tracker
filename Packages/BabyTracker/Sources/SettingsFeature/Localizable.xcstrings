    "Changes how volumes are shown. Nothing already logged is altered.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändert die Anzeige von Mengen. Bereits erfasste Einträge bleiben unverändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifie l'affichage des volumes. Les données déjà saisies ne changent pas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia cómo se muestran los volúmenes. Los datos ya registrados no se modifican."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia il modo in cui vengono mostrati i volumi. Le registrazioni esistenti non vengono modificate."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes how volumes are shown. Nothing already logged is altered."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змінює відображення об’єму. Збережені записи не зміняться."
          }
        }
      }
    },
