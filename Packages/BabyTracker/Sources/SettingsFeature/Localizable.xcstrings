    "You own this family. Tap a member to change their role or remove them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du besitzt diese Familie. Tippe auf ein Mitglied, um seine Rolle zu ändern oder es zu entfernen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes propriétaire de cette famille. Touchez un membre pour changer son rôle ou le retirer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eres el propietario de esta familia. Toca un miembro para cambiar su rol o eliminarlo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei il proprietario di questa famiglia. Tocca un membro per cambiarne il ruolo o rimuoverlo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You own this family. Tap a member to change their role or remove them."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви власник цієї сім’ї. Торкніться учасника, щоб змінити його роль або видалити його."
          }
        }
      }
    },
    "The family owner can add and remove caregivers.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Familieninhaber kann Betreuungspersonen hinzufügen und entfernen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le propriétaire de la famille peut ajouter et retirer des personnes aidantes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El propietario de la familia puede añadir y eliminar cuidadores."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il proprietario della famiglia può aggiungere e rimuovere caregiver."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The family owner can add and remove caregivers."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Власник сім’ї може додавати й видаляти опікунів."
          }
        }
      }
    },
    "View only": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur ansehen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lecture seule"
          }
        },
        "es": {
          "stringUnit": {
