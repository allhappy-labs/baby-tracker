    "This removes %@ from the family. Their devices lose access to this family's shared records. This does not restore a local copy on any device.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird %@ aus der Familie entfernt. Die Geräte dieser Person verlieren den Zugriff auf die gemeinsamen Einträge der Familie. Eine lokale Kopie wird auf keinem Gerät wiederhergestellt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela retire %@ de la famille. Ses appareils perdent l'accès aux données partagées de cette famille. Aucune copie locale n'est restaurée sur aucun appareil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina a %@ de la familia. Sus dispositivos perderán acceso a los registros compartidos de esta familia. No se restaura ninguna copia local en ningún dispositivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo rimuove %@ dalla famiglia. I suoi dispositivi perdono l'accesso alle registrazioni condivise della famiglia. Nessuna copia locale viene ripristinata su alcun dispositivo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes %@ from the family. Their devices lose access to this family's shared records. This does not restore a local copy on any device."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ буде видалено із сім’ї. Пристрої цієї людини втратять доступ до спільних записів. Локальна копія не відновиться на жодному пристрої."
          }
        }
      }
    },
