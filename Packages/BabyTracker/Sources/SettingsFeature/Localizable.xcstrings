    "You own a family. Hand ownership to another caregiver before deleting your account.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du besitzt eine Familie. Übertrage die Inhaberschaft auf eine andere Betreuungsperson, bevor du dein Konto löschst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes propriétaire d'une famille. Transférez la propriété à une autre personne aidante avant de supprimer votre compte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eres propietario de una familia. Transfiere la propiedad a otro cuidador antes de eliminar tu cuenta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei proprietario di una famiglia. Trasferisci la proprietà a un altro caregiver prima di eliminare il tuo account."
          }
