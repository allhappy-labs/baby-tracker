            "state": "translated",
            "value": "Confirmer"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmar"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conferma"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підтвердити"
          }
        }
      }
    },
    "That name couldn't be saved.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Name konnte nicht gespeichert werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce nom n'a pas pu être enregistré."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar ese nombre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare questo nome."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That name couldn't be saved."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зберегти ім’я."
          }
        }
      }
    },
    "Export family data": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Familiendaten exportieren"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporter les données familiales"
          }
        },
