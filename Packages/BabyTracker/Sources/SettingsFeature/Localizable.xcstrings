    "You have 10 open invitations. Revoke one to create another.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast 10 offene Einladungen. Widerrufe eine, um eine weitere zu erstellen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez 10 invitations en attente. Révoquez-en une pour en créer une autre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes 10 invitaciones pendientes. Revoca una para crear otra."
          }
        },
