    "This family is scheduled for deletion. You can recover it, or give up the recovery claim and let the deletion complete.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Löschung dieser Familie ist geplant. Du kannst sie wiederherstellen oder auf deinen Wiederherstellungsanspruch verzichten und die Löschung abschließen lassen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La suppression de cette famille est programmée. Vous pouvez la restaurer ou renoncer à votre droit de restauration et laisser la suppression s'achever."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha programado la eliminación de esta familia. Puedes recuperarla o renunciar al derecho de recuperación y dejar que se complete la eliminación."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'eliminazione di questa famiglia è programmata. Puoi ripristinarla oppure rinunciare al diritto di recupero e lasciare che l'eliminazione venga completata."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This family is scheduled for deletion. You can recover it, or give up the recovery claim and let the deletion complete."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалення цієї сім’ї заплановано. Ви можете відновити її або відмовитися від відновлення й дочекатися видалення."
          }
        }
      }
    },
