    "Only the family owner can remove a baby.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur der Familieninhaber kann ein Baby entfernen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul le propriétaire de la famille peut retirer un bébé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo el propietario de la familia puede eliminar un bebé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo il proprietario della famiglia può rimuovere un bebè."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the family owner can remove a baby."
          }
        },
