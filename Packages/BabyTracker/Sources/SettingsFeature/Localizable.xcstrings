    "Share tracking with another caregiver. Baby Tracker works fully without this.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teile die Erfassung mit einer weiteren Betreuungsperson. Baby Tracker funktioniert auch ohne diese Funktion vollständig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partagez le suivi avec une autre personne aidante. Baby Tracker fonctionne pleinement sans cette option."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte el seguimiento con otra persona cuidadora. Baby Tracker funciona plenamente sin esta opción."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condividi il monitoraggio con un altro caregiver. Baby Tracker funziona pienamente anche senza questa funzione."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share tracking with another caregiver. Baby Tracker works fully without this."
          }
        },
        "uk": {
