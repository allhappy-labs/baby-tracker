    "This code was created before a reinstall or on another phone. Revoke it and create a new one if you need to share it again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Code wurde vor einer Neuinstallation oder auf einem anderen Telefon erstellt. Widerrufe ihn und erstelle einen neuen, wenn du ihn erneut teilen möchtest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce code a été créé avant une réinstallation ou sur un autre téléphone. Révoquez-le et créez-en un autre si vous devez le partager à nouveau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este código se creó antes de reinstalar la app o en otro teléfono. Revócalo y crea uno nuevo si necesitas volver a compartirlo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo codice è stato creato prima di una reinstallazione o su un altro telefono. Revocalo e creane uno nuovo se devi condividerlo di nuovo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This code was created before a reinstall or on another phone. Revoke it and create a new one if you need to share it again."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей код створено до перевстановлення або на іншому телефоні. Якщо потрібно поділитися ним знову, скасуйте його й створіть новий."
          }
        }
      }
    },
