    "Ranks are rounded estimates. Values below P3 or above P97 show <3rd or >97th rather than an extrapolated rank.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ränge sind gerundete Schätzungen. Werte unter P3 oder über P97 werden als <3. oder >97. statt als extrapolierter Rang angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ranks are rounded estimates. Values below P3 or above P97 show <3rd or >97th rather than an extrapolated rank."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los rangos son estimaciones redondeadas. Por debajo de P3 o encima de P97 se muestra <3.º o >97.º en lugar de un rango extrapolado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rangs sont des estimations arrondies. Sous P3 ou au-dessus de P97, <3e ou >97e remplace un rang extrapolé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I ranghi sono stime arrotondate. Sotto P3 o sopra P97 si mostra <3° o >97° anziché un rango estrapolato."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ранги — округлені оцінки. Нижче P3 або вище P97 показано <3-го або >97-го замість екстрапольованого рангу."
          }
        }
      }
    },
