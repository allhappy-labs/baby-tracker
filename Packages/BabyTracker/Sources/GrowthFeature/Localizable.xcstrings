    "Choose a growth reference to enable comparisons.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine Wachstumsreferenz für Vergleiche."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a growth reference to enable comparisons."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una referencia de crecimiento para activar las comparaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une référence de croissance pour activer les comparaisons."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un riferimento di crescita per abilitare i confronti."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оберіть еталон росту для порівняння."
          }
        }
      }
    },
    "Choose lying down or standing up for a reference comparison.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle liegend oder stehend für einen Referenzvergleich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose lying down or standing up for a reference comparison."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige tumbado o de pie para una comparación de referencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez couché ou debout pour une comparaison de référence."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli sdraiato o in piedi per un confronto."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть положення лежачи або стоячи для порівняння."
          }
        }
      }
    },
    "Choose the girls’ or boys’ reference for comparisons. Your recorded measurements stay available.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle zum Vergleichen die Referenz für Mädchen oder Jungen. Deine erfassten Messungen bleiben verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the girls’ or boys’ reference for comparisons. Your recorded measurements stay available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige la referencia de niñas o niños para las comparaciones. Las medidas registradas seguirán disponibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez la référence filles ou garçons pour les comparaisons. Vos mesures enregistrées restent disponibles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli il riferimento per bambine o bambini per i confronti. Le misure registrate restano disponibili."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оберіть еталон для дівчаток або хлопчиків для порівняння. Записані вимірювання залишаться доступними."
          }
        }
      }
    },
