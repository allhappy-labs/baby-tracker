    },
    "These comparisons describe a population reference; they do not diagnose growth concerns.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Vergleiche beschreiben eine Bevölkerungsreferenz; sie diagnostizieren keine Wachstumsprobleme."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These comparisons describe a population reference; they do not diagnose growth concerns."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas comparaciones describen una referencia poblacional; no diagnostican problemas de crecimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces comparaisons décrivent une référence de population ; elles ne diagnostiquent pas de problèmes de croissance."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi confronti descrivono un riferimento della popolazione; non diagnosticano problemi di crescita."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ці порівняння описують еталон популяції; вони не діагностують проблем росту."
          }
        }
      }
    },
    "This reading is before the birth or corrected-age reference start.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
