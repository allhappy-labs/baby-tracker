{
  "sourceLanguage": "en",
  "strings": {
    "Apple Intelligence is unavailable on this device.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence недоступний на цьому пристрої."
          }
        }
      }
    },
    "Ask": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запитати"
          }
        }
      }
    },
    "Ask a question": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поставте запитання"
          }
        }
      }
    },
    "Ask about %@’s care, or ask a general parenting question.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запитайте про догляд за %@ або поставте загальне запитання про батьківство."
          }
        }
      }
    },
    "Ask can't help with that one.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask не може допомогти з цим запитанням."
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скасувати"
          }
        }
      }
    },
