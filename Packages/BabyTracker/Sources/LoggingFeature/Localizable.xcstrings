    "Couldn’t load meds. Close this sheet and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t load meds. Close this sheet and try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Medizin konnte nicht geladen werden. Schließe dieses Fenster und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger les médicaments. Fermez cette fenêtre et réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron cargar las medicinas. Cierra esta pantalla e inténtalo de nuevo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile caricare i farmaci. Chiudi questa schermata e riprova."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завантажити ліки. Закрийте це вікно й спробуйте ще раз."
          }
        }
      }
    },
    "Couldn’t save measurement. Your entry is still here; try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Messung konnte nicht gespeichert werden. Deine Eingabe bleibt erhalten; versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer la mesure. Votre saisie est conservée ; réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar la medida. Tu entrada sigue aquí; inténtalo de nuevo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare la misura. I dati sono ancora qui; riprova."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зберегти вимірювання. Ваші дані збережено у формі; спробуйте ще раз."
          }
        }
      }
    },
