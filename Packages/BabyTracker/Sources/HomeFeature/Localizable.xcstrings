    "Family sync needs attention. Please try again later.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Familiensynchronisierung erfordert Aufmerksamkeit. Bitte versuche es später erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation familiale nécessite votre attention. Réessayez plus tard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización familiar necesita atención. Inténtalo de nuevo más tarde."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronizzazione familiare richiede attenzione. Riprova più tardi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сімейна синхронізація потребує уваги. Повторіть спробу пізніше."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Family sync needs attention. Please try again later."
