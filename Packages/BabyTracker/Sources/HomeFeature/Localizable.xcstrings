    "This timer changed on another phone. Close and open it again to edit it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Timer wurde auf einem anderen Telefon geändert. Schließe ihn und öffne ihn erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce minuteur a changé sur un autre téléphone. Fermez-le puis rouvrez-le pour le modifier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este temporizador cambió en otro teléfono. Ciérralo y vuelve a abrirlo para editarlo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo timer è stato modificato su un altro telefono. Chiudilo e riaprilo per modificarlo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей таймер змінили на іншому телефоні. Закрийте й відкрийте його знову для редагування."
          }
        }
      }
    },
    "This timer was stopped on another phone — edit the %@ in History.": {
      "localizations": {
        "de": {
          "stringUnit": {
