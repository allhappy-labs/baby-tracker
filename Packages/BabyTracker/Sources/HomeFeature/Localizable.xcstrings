    "Could not sign in. Your queued entries remain on this phone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmeldung fehlgeschlagen. Deine ausstehenden Einträge bleiben auf diesem Telefon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion impossible. Vos entrées en attente restent sur ce téléphone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar sesión. Tus entradas pendientes permanecen en este teléfono."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesso non riuscito. Le voci in attesa restano su questo telefono."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося ввійти. Записи в черзі залишаються на цьому телефоні."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not sign in. Your queued entries remain on this phone."
          }
        }
      }
    },
