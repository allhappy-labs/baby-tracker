    "That start time is outside the allowed range.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Startzeit liegt außerhalb des zulässigen Bereichs."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette heure de début est hors de la plage autorisée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La hora de inicio está fuera del intervalo permitido."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ora di inizio è fuori dall'intervallo consentito."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Час початку поза допустимим діапазоном."
          }
        }
      }
    },
    "The finished parts add up to more time than the feed has run. Shorten a part or move the start earlier.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die abgeschlossenen Abschnitte dauern länger als die Mahlzeit bisher. Kürze einen Abschnitt oder verlege den Start nach vorne."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La durée des étapes terminées dépasse celle du repas. Raccourcissez une étape ou avancez le début."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las partes terminadas duran más que la toma. Acorta una parte o adelanta el inicio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fasi completate durano più della poppata. Accorcia una fase o anticipa l'inizio."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сума завершених частин перевищує тривалість годування. Скоротіть частину або пересуньте початок на раніший час."
          }
        }
      }
    },
    "The part that's running keeps counting. Stop it to finish.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der laufende Teil zählt weiter. Stoppe ihn, um ihn abzuschließen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La partie en cours continue de compter. Arrêtez-la pour la terminer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La parte en curso sigue contando. Detenla para terminarla."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La parte in corso continua a contare. Fermala per terminarla."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поточна частина продовжує відлік. Зупиніть її, щоб завершити."
          }
        }
      }
    },
    "The start can't be after the bottle began, at %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Startzeit darf nicht nach dem Beginn des Fläschchens (%@) liegen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’heure de début ne peut pas être après le début du biberon (%@)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La hora de inicio no puede ser posterior al comienzo del biberón (%@)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’inizio non può essere successivo all’inizio del biberon (%@)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Час початку не може бути пізнішим за початок годування з пляшечки о %@."
          }
        }
      }
    },
    "The start can't be after the left breast began, at %@.": {
