  "constraint|public|care_entities.care_entities_kind_shape|type=c|def=CHECK ((((kind = ANY (ARRAY[1, 10])) = (baby_id IS NULL)) AND ((kind = 1) = (sort_order IS NOT NULL)) AND ((kind = 1) = (name_hash IS NOT NULL)) AND ((kind = 5) = (timer_kind IS NOT NULL)) AND ((kind = 6) = (label IS NOT NULL)) AND ((kind = ANY (ARRAY[2, 3, 4, 5, 6, 8, 9, 10])) = (started_at IS NOT NULL)) AND ((ended_at IS NULL) OR (kind = ANY (ARRAY[2, 3, 4, 10]))) AND ((session_id IS NULL) OR (kind = ANY (ARRAY[2, 3, 5]))) AND ((completed_record_id IS NULL) OR ((kind = 5) AND (tombstoned_at IS NOT NULL))) AND ((kind = 2) OR ((breast_seconds = 0) AND (bottle_volume_ml IS NULL) AND (bottle_observations = 0) AND (bottle_missing = 0))) AND ((shortest_part_seconds IS NULL) OR (kind = ANY (ARRAY[2, 5]))) AND ((breast_seconds = 0) OR (shortest_part_seconds IS NOT NULL)) AND ((shortest_part_seconds IS NULL) OR (timer_kind IS DISTINCT FROM 2)) AND ((bottle_volume_ml IS NULL) = (bottle_observations = 0)) AND ((tombstoned_at IS NULL) OR ((breast_seconds = 0) AND (bottle_observations = 0) AND (bottle_missing = 0) AND (shortest_part_seconds IS NULL)))))|deferrable=false|deferred=false|validated=true",
